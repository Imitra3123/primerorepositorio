{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Build Calculator with Raylib",
            "command": "g++",
            "args": [
                "-g",
                "${workspaceFolder}/20-08-2026/impcalc/impcalC.cpp",
                "${workspaceFolder}/20-08-2026/impcalc/impcalCUI.cpp",
                "${workspaceFolder}/20-08-2026/impcalc/Operations/*.cpp",
                "-o",
                "${workspaceFolder}/20-08-2026/impcalc/impcalC.exe",
                "-I${workspaceFolder}/20-08-2026/impcalc/raylib/include",
                "-L${workspaceFolder}/20-08-2026/impcalc/raylib/lib",
                "-lraylib",
                "-lopengl32",
                "-lgdi32",
                "-lwinmm"
            ],
            "options": {
                "cwd": "${workspaceFolder}/20-08-2026/impcalc"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
